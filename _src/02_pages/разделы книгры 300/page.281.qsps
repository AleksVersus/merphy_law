# page.281
$lvar['заголовок'] = "Мир Легенд"
$lvar['исходник'] = "<p align=justify>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;«Мне везет! — бурно радуется ваш противник. — Сыграем ещё раз?»
     Хотите "
gosub 'get.daughter.obj',$curloc
if arrsize('$temp_id')>0:
	$lvar['исходник'] += '<a l:href="#n_543">снова рискнуть</a><lock.put>'
	$GAME_VALUE['obj.inGame']=$temp_id[0]
else
	$lvar['исходник'] += 'снова рискнуть'
end
killvar '$temp_id'
$lvar['исходник'] += "? Если считаете, что пора бросить эту затею (или вам больше нечего поставить на кон), то проститесь с партнером и [page=240]идите спать[/page].
     
     "
gosub 'get.daughter.obj',$curloc
if arrsize('$temp_id')=0:
	$lvar['исходник'] += $func('base.texts','help.putobj')
else
	$lvar['исходник'] += ''
end
killvar '$temp_id'
$lvar['исходник'] += "</p>"
--- page.281 ---------------------------------
